# Copy this file to .env and add your own key. Never commit .env.
DEEPSEEK_API_KEY=

# Optional: defaults to deepseek-v4-flash in this demo.
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: keep the official endpoint unless your network uses an approved compatible gateway.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# Used for evidence-based keyframe evaluation of uploaded video.
ARK_API_KEY=
ARK_VISION_MODEL=doubao-seed-2-0-lite-260215

# Required for the Agent to generate real Seedance video versions.
# Use an enabled Seedance Model ID or Ark Endpoint ID from the video-generation API page.
ARK_VIDEO_TEXT_MODEL=
# Optional: only set this to a separately verified image-reference-capable
# model/endpoint. The Agent never assumes that ARK_VIDEO_TEXT_MODEL accepts
# reference pixels (especially the retained Seedance 1.0 Pro test adapter).
ARK_VIDEO_REFERENCE_MODEL=

# Select exactly one generation adapter: `ark` (existing Seedance test path)
# or `minimax_h3`. The Agent never switches provider implicitly.
VIDEO_PROVIDER=ark

# Official MiniMax H3 V2 adapter. To use it, set VIDEO_PROVIDER=minimax_h3
# and add a pay-as-you-go MiniMax API key. The Agent sends a documented H3
# `content` array: text plus up to nine `reference_image` items and up to
# three `reference_audio` items, in the user's attachment order. It does not
# mix those references with H3 first/last-frame modes.
MINIMAX_API_KEY=
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=768P
# Optional, only if your MiniMax account requires a different API host.
MINIMAX_API_BASE_URL=https://api.minimaxi.com

# Required to unlock paid AI actions. Set your own FOUR DIGITS; no default code.
# Keep this server-side. Do not put it in frontend files or GitHub Pages settings.
TRIAL_CODES=
# Lifetime call ceiling for planning/evaluation/generation attempts per grant.
TRIAL_AI_CALL_LIMIT=100
# Set to 1 behind HTTPS; keep 0 for plain HTTP local development.
COOKIE_SECURE=0
# Only needed for the Docker Compose HTTPS deployment, e.g. demo.your-domain.com.
SITE_DOMAIN=
